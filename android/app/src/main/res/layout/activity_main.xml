<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#0F141C">
    <TextView android:id="@+id/version" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F1F5F9" android:textStyle="bold" android:text="@string/app_name" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="#94A3B8" android:text="@string/mic_in" />
    <ProgressBar android:id="@+id/meterIn" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:max="1000" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="#94A3B8" android:text="@string/fader" />
    <SeekBar android:id="@+id/fader" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/faderDb" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#00F2FF" android:text="+0.0 dB" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="#94A3B8" android:text="@string/pan" />
    <SeekBar android:id="@+id/pan" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <ToggleButton android:id="@+id/mute" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textOn="@string/mute_on" android:textOff="@string/mute_off" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="#94A3B8" android:text="@string/master" />
    <ProgressBar android:id="@+id/meterL" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:max="1000" />
    <ProgressBar android:id="@+id/meterR" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="4dp" android:max="1000" />
    <Button android:id="@+id/remote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/open_remote" />
    <Button android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/start" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="#64748B" android:textSize="12sp" android:text="@string/note" />
</LinearLayout>
