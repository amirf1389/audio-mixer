{
  "name": "audio-mixer",
  "version": "1.24.0.3",
  "releaseChannel": "",
  "description": "A mix OS: native mixing console (Qt Quick on a C++20 engine: ASIO / WASAPI / Core Audio / ALSA) plus the legacy engine service and the vendor licence tools.",
  "private": true,
  "license": "MIT",
  "bin": {
    "audio-mixer": "client/cli.js"
  },
  "scripts": {
    "start": "node client/cli.js",
    "server": "node bridge/server.js",
    "drivers": "node client/cli.js drivers",
    "doctor": "node client/cli.js doctor",
    "test": "cd bridge && npm test",
    "setup": "node client/cli.js setup",
    "license": "node scripts/license.js",
    "service:install": "node client/cli.js service install",
    "service:uninstall": "node client/cli.js service uninstall",
    "pc": "node client/cli.js",
    "pc:headless": "node client/cli.js --no-open",
    "finder": "node client/finder.js",
    "flexasio": "node scripts/install-flexasio.js",
    "service:nssm": "node scripts/service.js nssm install",
    "service:pm2": "node scripts/service.js pm2 start",
    "verify": "node client/cli.js verify",
    "setup:audify": "cd bridge && npm install audify",
    "build:unix": "node scripts/build-unix.js",
    "ota-server": "node ota-server/server.js",
    "ota": "node scripts/ota.js",
    "ota:local": "node scripts/ota-local.js",
    "engine": "node scripts/build-engine.js",
    "license:generator": "node scripts/license-generator.js --open",
    "perf": "node scripts/perf-controller.js",
    "native": "cmake -S native/amixos -B build/amixos && cmake --build build/amixos -j && ctest --test-dir build/amixos --output-on-failure",
    "engine:test": "cmake -S engine/cpp -B build/engine && cmake --build build/engine -j && ctest --test-dir build/engine --output-on-failure"
  },
  "engines": {
    "node": ">=18"
  }
}
