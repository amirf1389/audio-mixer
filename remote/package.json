{
  "name": "amixos-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A mix OS remote: a React Native (TypeScript) phone app that drives amixos-daemon over its local JSON / WebSocket API.",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test:client": "tsc -p tsconfig.client.json && node test/client.test.mjs"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "typescript": "~5.6.3"
  }
}
