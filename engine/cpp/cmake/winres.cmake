# amfb_win_version(<target> <file name> <description> APP|DLL): a Windows version resource (and, for programs, an asInvoker manifest) on a
if(WIN32)
  enable_language(RC)   # windres (mingw) / rc (MSVC)
endif()
# target, so every AmF X1 binary names its publisher, product, version and purpose. No-op off Windows.
function(amfb_win_version target file desc kind)
  if(NOT WIN32)
    return()
  endif()
  set(_vfile "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../../native/amixos/version.txt")
  file(READ "${_vfile}" _v)
  string(STRIP "${_v}" AMFB_VERSION)
  string(REPLACE "." ";" _parts "${AMFB_VERSION}")
  list(APPEND _parts 0 0 0 0)
  list(GET _parts 0 AMFB_V1)
  list(GET _parts 1 AMFB_V2)
  list(GET _parts 2 AMFB_V3)
  list(GET _parts 3 AMFB_V4)
  set(AMFB_FILE "${file}")
  set(AMFB_DESC "${desc}")
  string(MAKE_C_IDENTIFIER "${file}" AMFB_INTERNAL)   # the file name: unique even where target names differ only by - and _
  set(_out "${CMAKE_CURRENT_BINARY_DIR}/winres_${AMFB_INTERNAL}")
  if(kind STREQUAL "APP")
    set(AMFB_FILETYPE "VFT_APP")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/app.manifest.in" "${_out}.manifest" @ONLY)
    set(AMFB_MANIFEST_LINE "1 24 \"winres_${AMFB_INTERNAL}.manifest\"")
  else()
    set(AMFB_FILETYPE "VFT_DLL")
  set(AMFB_MANIFEST_LINE "")
  endif()
  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/version.rc.in" "${_out}.rc" @ONLY)
  target_sources(${target} PRIVATE "${_out}.rc")
endfunction()
