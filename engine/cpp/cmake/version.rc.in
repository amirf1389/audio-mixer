// Version information of @AMFB_FILE@ (AmF X1 by AMFB Audio), generated by cmake/winres.cmake. Properties > Details shows it; a scanner sees a
// named publisher and product instead of an anonymous binary.
#include <winver.h>
@AMFB_MANIFEST_LINE@
1 VERSIONINFO
 FILEVERSION @AMFB_V1@,@AMFB_V2@,@AMFB_V3@,@AMFB_V4@
 PRODUCTVERSION @AMFB_V1@,@AMFB_V2@,@AMFB_V3@,@AMFB_V4@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @AMFB_FILETYPE@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "AMFB Audio"
      VALUE "ProductName", "AmF X1"
      VALUE "FileDescription", "@AMFB_DESC@"
      VALUE "FileVersion", "@AMFB_VERSION@"
      VALUE "ProductVersion", "@AMFB_VERSION@"
      VALUE "InternalName", "@AMFB_INTERNAL@"
      VALUE "OriginalFilename", "@AMFB_FILE@"
      VALUE "LegalCopyright", "Copyright AMFB Audio. Licensed under the MIT License."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
