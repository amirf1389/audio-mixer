# Copy to .env in this folder (file mode 600, never in git). Make the three secrets with:  python -m lkms.keygen
LKMS_DOMAIN=licence.example.com
# Who may open the admin console and admin API: your office address, your VPN range. Space-separated.
LKMS_ADMIN_ALLOW=203.0.113.7
# A long random password for the database (only used inside the compose network):  openssl rand -base64 32
LKMS_DB_PASSWORD=
LKMS_ADMIN_KEY_HASH=
LKMS_KEY_PEPPER=
LKMS_SIGNING_KEY=
# Days a device runs without the server: 168 hours = 7 days. Days a site host runs without the server: 720 hours = 30 days.
LKMS_LEASE_HOURS=168
LKMS_GRANT_HOURS=720
LKMS_ADMIN_UI=1
