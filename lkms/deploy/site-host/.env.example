# Copy to .env. The vendor gives the customer these five values with the volume licence.
LKMS_HOST_CENTRAL_URL=https://licence.example.com
LKMS_HOST_APP_ID=
LKMS_HOST_APP_SECRET=
LKMS_HOST_LICENSE_KEY=
LKMS_HOST_CENTRAL_PUBLIC_KEY=
# How long a computer runs away from the site (hours), and after how many days an unseen computer's seat is freed.
LKMS_HOST_CLIENT_LEASE_HOURS=168
LKMS_HOST_RECLAIM_DAYS=30
