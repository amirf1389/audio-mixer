# Copy to .env (never commit .env). Make the values with:  python -m lkms.keygen
LKMS_DATABASE_URL=postgresql://lkms:CHANGE_ME@127.0.0.1:5432/lkms
# SHA-256 (hex) of the master admin key. The key itself lives only in your password manager.
LKMS_ADMIN_KEY_HASH=
# Random pepper for licence-key hashes (base64, 32 bytes). Losing it makes every issued key unreadable to the server: back it up.
LKMS_KEY_PEPPER=
# Ed25519 private key (base64, 32 bytes) that signs the leases the apps cache. Its public half goes into your apps.
LKMS_SIGNING_KEY=
# How long an app may run from its cached lease when the server cannot be reached.
LKMS_LEASE_HOURS=168
# Set to 1 only behind your own reverse proxy, so the client address is read from X-Forwarded-For.
LKMS_TRUST_PROXY=0
# Set to 1 to serve the admin console at /manage. Keep /manage and /admin behind your VPN or address list.
LKMS_ADMIN_UI=0
