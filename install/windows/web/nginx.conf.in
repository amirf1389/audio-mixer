# AmF X1 WEB REMOTE front (nginx for Windows, bundled under web\nginx). Written from this template by the console (NETWORK page,
# WEB STACK) or by web\start-web-stack.cmd; the @...@ fields are filled in there. It serves the browser remote and reverse-proxies
# the service ("AmF X1 Network.exe", 127.0.0.1:@DAEMON_PORT@) including its WebSocket. No status / admin pages, no directory listings.
# The in-service web remote (http://<pc>:@DAEMON_PORT@/remote) keeps working without this.
worker_processes 1;
error_log logs/error.log warn;
pid logs/nginx.pid;
events { worker_connections 256; }

http {
    include       "@NGINX_DIR@/conf/mime.types";
    default_type  application/octet-stream;
    server_tokens off;
    autoindex off;
    sendfile on;
    keepalive_timeout 30s;
    client_max_body_size 256k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    access_log logs/access.log;

    map $http_upgrade $amfx1_upgrade { default upgrade; '' close; }

    upstream amfx1_daemon { server 127.0.0.1:@DAEMON_PORT@; keepalive 8; }
    upstream amfx1_bridge { server 127.0.0.1:@BRIDGE_PORT@; }

    server {
        listen @LISTEN_ADDR@:@LISTEN_PORT@;
        server_name _;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()" always;

        location = / { return 302 /remote/; }
        location = /remote { return 302 /remote/; }
        location = /remote/ {   # the browser remote, from the package (web\remote\index.html)
            root "@WEB_DIR@";
            try_files /remote/index.html =404;
            add_header Cache-Control "no-store" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
            add_header Referrer-Policy "no-referrer" always;
            add_header Cross-Origin-Opener-Policy "same-origin" always;
            add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()" always;
            add_header Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; frame-src https://www.youtube-nocookie.com; connect-src 'self' ws: wss:; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        }

        location /bridge/ {   # the Node bridge (web\bridge), started with the stack; loopback only
            allow 127.0.0.1; deny all;
            proxy_pass http://amfx1_bridge/;
            proxy_http_version 1.1;
            proxy_set_header Host 127.0.0.1:@BRIDGE_PORT@;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $amfx1_upgrade;
            proxy_read_timeout 1h;
        }

        location / {   # the service: /api/..., the live WebSocket, the favicon
            proxy_pass http://amfx1_daemon;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $amfx1_upgrade;
            proxy_read_timeout 1h;
            proxy_send_timeout 1h;
            proxy_buffering off;
        }
    }
}
