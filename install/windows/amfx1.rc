// Version information and manifest of AmF X1.exe (the engine program). What Windows Defender, SmartScreen and the file's Properties
// dialog read: a real company, product, description and version. Filled in by scripts/build-native.js (@VERSION@ / @VERSION4@).
#include <winver.h>
1 24 "amfx1.manifest"
1 VERSIONINFO
 FILEVERSION @VERSION4@
 PRODUCTVERSION @VERSION4@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "AMFB Audio"
      VALUE "ProductName", "AmF X1"
      VALUE "FileDescription", "AmF X1 audio engine by AMFB Audio"
      VALUE "FileVersion", "@VERSION@"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "InternalName", "AmF X1"
      VALUE "OriginalFilename", "AmF X1.exe"
      VALUE "LegalCopyright", "Copyright AMFB Audio. Licensed under the MIT License."
      VALUE "Comments", "Professional audio mixing engine: ASIO, WASAPI, DirectSound. https://github.com/amirf1389/audio-mixer"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
