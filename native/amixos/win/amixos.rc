// Version information and manifest of amixos.exe, the AmF X1 console (Windows). Same company / product data as AmF X1.exe (install/windows/amfx1.rc).
#include <winver.h>
IDI_ICON1 ICON "amfx1.ico"   // the mixer logo: the program file, the task bar, the shortcuts
1 24 "amixos.manifest"
1 VERSIONINFO
 FILEVERSION 1,24,0,0
 PRODUCTVERSION 1,24,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "AMFB Audio"
      VALUE "ProductName", "AmF X1"
      VALUE "FileDescription", "AmF X1 console by AMFB Audio"
      VALUE "FileVersion", "1.24.0.0"
      VALUE "ProductVersion", "1.24.0.0"
      VALUE "InternalName", "amixos"
      VALUE "OriginalFilename", "amixos.exe"
      VALUE "LegalCopyright", "Copyright AMFB Audio. Licensed under the MIT License."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
