# Caddy gets and renews the certificate by itself:  caddy run --config deploy/ota/Caddyfile
# Run the server with OTA_TRUST_PROXY=1 OTA_PUBLIC_URL=https://ota.example.com
ota.example.com {
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"   # HTTPS only from now on (Caddy serves the certificate)
  reverse_proxy 127.0.0.1:8780
  request_body {
    max_size 450MB
  }
}
