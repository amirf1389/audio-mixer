# AmF X1 portal settings. Copy is made by init.sh / init.ps1, which also fills in every secret below with fresh random values
# and saves the result as .env readable only by you (0600). NEVER commit .env or the secrets/ folder. No value here is a real secret.

# ── Domains (Caddy gets the HTTPS certificates for them by itself; each needs a DNS A record to this server) ──
# Public site: the app's update check (/update.json, /releases/...), the download page (/), the licence API (/activate, /status, ...),
# the customer portal (/portal/) and My account (/account/). Nothing for staff is served here: /admin/ and /issue answer 404.
PUBLIC_DOMAIN=updates.example.com
# Staff dashboard of the licence server (licences, CRM, website/presets, system, backups). Staff only.
ADMIN_DOMAIN=admin.example.com
# Staff dashboard of the OTA server (release files, manifests, audit). Staff only.
OTA_ADMIN_DOMAIN=ota-admin.example.com
# The e-mail Let's Encrypt sends certificate notices to.
ACME_EMAIL=you@example.com
# Who may open the two staff hosts: space-separated IP addresses / CIDR ranges (your office, your home, a VPN).
# The default lets everyone reach the sign-in page (it still needs a password); set your own addresses to lock it down.
ADMIN_ALLOW_IPS=0.0.0.0/0 ::/0

# ── Secrets (init.sh writes these; 48 random bytes each, base64url). Changing one later: see README "Rotating secrets". ──
# Admin token of the licence server: full control; used by tools/add-staff.js and tools/staff-backup.js. Keep it off every browser.
LICENSE_ADMIN_TOKEN=
# Admin token of the OTA server: what scripts/ota.js publish --token uses on the owner's PC.
OTA_ADMIN_TOKEN=
# Signs the staff sign-in tokens (8 hours); shared by both servers so one sign-in opens both dashboards.
PORTAL_JWT_SECRET=
# Encrypts the CRM (customers, notes) in the staff database; only the licence server has it.
PORTAL_CRM_SECRET=

# ── Key files (paths relative to this folder; in Docker they are mounted read-only from ./secrets) ──
# The vendor PRIVATE key (P-256 PEM). The licence server needs it to sign licence keys, activations and the revocation list.
# Copy it here yourself from your PC (scp), chmod 600. The server refuses to start if other users can read it.
LICENSE_PRIVATE_KEY_FILE=secrets/vendor-private.pem
# Encrypts the customer name / e-mail / note of each licence record (written by init.sh).
LICENSE_DATA_KEY_FILE=secrets/licence-data.key

# ── Without Docker only (start.js / systemd); in Docker these are fixed in docker-compose.yml ──
# Where licence records, the staff database, the audit logs and the OTA files live.
DATA_DIR=data
# The servers listen here; keep 127.0.0.1 so only Caddy on this machine reaches them.
BIND_HOST=127.0.0.1
LICENSE_PORT=8787
OTA_PORT=8780
# 1 = take the caller's address from X-Forwarded-For (correct behind Caddy). 0 only when nothing is in front.
TRUST_PROXY=1
# Release files the customer portal offers (/portal/downloads): features.json, windows/*.exe|*.zip, android/*.apk
LICENSE_RELEASES_DIR=site-releases

# ── Optional ──
# Public address of the OTA server; manifests are only accepted when their file URLs start with <this>/releases/. Default https://PUBLIC_DOMAIN
OTA_PUBLIC_URL=
# The update list the customer portal shows. Default https://PUBLIC_DOMAIN/update.json
LICENSE_UPDATE_URL=
# Downloads per minute per address on the OTA server.
OTA_RATE=120
# 1 = accept http:// file URLs in manifests. Local testing only.
OTA_ALLOW_HTTP=
# A different PUBLIC key (JWK file) for checking manifests. Empty = the key that ships in the apps (bridge/license-public.json). Testing only.
OTA_PUBLIC_KEY_FILE=
# Mail server for the "request a key" receipt e-mail (empty = requests are stored, not e-mailed).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
