# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# nginx secrets
deploy/nginx/.htpasswd_mixer
deploy/nginx/certs/
deploy/nginx/logs/
# keep the fail2ban config dirs (the generic *.d rule above would hide them)
!deploy/nginx/fail2ban/filter.d/
!deploy/nginx/fail2ban/jail.d/

# PC-mode build output
dist/

!releases/*.exe

# Windows helper binaries built from native/win/src (kept in the repository, the installers ship them)
!native/**/*.exe

# Qt Android project: staged page and build output
android-qt/assets/
android-qt/build/

# the driver Makefiles are source, not build output
!drivers/**/Makefile
