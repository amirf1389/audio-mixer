# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
!releases/native/*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# nginx secrets
deploy/nginx/.htpasswd_mixer
deploy/nginx/certs/
deploy/nginx/logs/
# keep the fail2ban config dirs (the generic *.d rule above would hide them)
!deploy/nginx/fail2ban/filter.d/
!deploy/nginx/fail2ban/jail.d/

# PC-mode build output
dist/

!platforms/windows/releases/*.exe

# Windows helper binaries built from platforms/windows/native/src and platforms/windows/plugin-host (kept in the repository, the installers ship them)
!platforms/windows/native/**/*.exe
!platforms/windows/plugin-host/**/*.exe

# Qt Android project: staged page and build output
platforms/android/qt/assets/
platforms/android/qt/android/src/
platforms/android/qt/build/

# the driver Makefiles are source, not build output
!drivers/**/Makefile
!platforms/linux/alsa-plugin/Makefile
!platforms/macos/coreaudio-driver/Makefile

# engine build output (node scripts/build-engine.js)
engine/rust/target/
engine/embedded-c/build/
engine/cpp/build/
engine/node/build/
!engine/**/Makefile
bridge/license-sandbox-public.json

# Local secure OTA demo environment (scripts/ota-local.js): generated vendor keys, TLS cert and demo data. Never commit these.
.local-ota/

# Electron platform package (platforms/electron): its own node_modules, generated icons, and packaged output.
platforms/electron/node_modules/
platforms/electron/build/
dist/electron/
