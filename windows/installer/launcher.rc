#include <winver.h>
1 ICON "AudioMixer.ico"
1 24 "launcher.manifest"
1 VERSIONINFO
 FILEVERSION @VERSION4@
 PRODUCTVERSION @VERSION4@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "Audio Mixer"
      VALUE "FileDescription", "Audio Mixer server launcher"
      VALUE "FileVersion", "@VERSION@"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "CompanyName", "Audio Mixer"
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
